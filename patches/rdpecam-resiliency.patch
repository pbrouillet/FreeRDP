@@ -142,8 +142,18 @@ FREERDP_VIDEO_CONTEXT* freerdp_video_context_new(UINT32 width, UINT32 height)
 
 	context->mjpegDecoder->width = (int)width;
 	context->mjpegDecoder->height = (int)height;
-	/* Abort on minor errors to skip corrupted frames */
-	context->mjpegDecoder->err_recognition |= AV_EF_EXPLODE;
+	/*
+	 * Keep the MJPEG decoder lenient for best-effort webcam capture. With
+	 * AV_EF_EXPLODE, minor/recoverable issues (common with webcam MJPEG, which
+	 * embeds vendor APP markers and occasionally imperfect frames) are promoted
+	 * to fatal decode failures, needlessly dropping otherwise-usable frames.
+	 * Clearing err_recognition lets the decoder conceal such glitches and still
+	 * emit a frame; truly undecodable input is still rejected via the
+	 * avcodec_send_packet/receive_frame return codes below and dropped without
+	 * tearing down the stream. (The accompanying "unable to decode APP fields"
+	 * log spam is handled separately by the FFmpeg->WLog callback.)
+	 */
+	context->mjpegDecoder->err_recognition = 0;
 
 	if (avcodec_open2(context->mjpegDecoder, codec, nullptr) < 0)
 	{
