+		static int warned = 0;
+		if (!warned)
+		{
+			warned = 1;
+			(void)fprintf(stderr,
+			              "%s: pointer coordinate %f out of range [0, %d], clamping. "
+			              "Please report this with reproduction steps.\n",
+			              __func__, v, INT32_MAX);
+		}
+		return (uint32_t)INT32_MAX;
+	}
+	return (uint32_t)lround(v);
+}
