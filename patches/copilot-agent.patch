+ uwac/libuwac/uwac-priv.h    |  11 ++
+ uwac/libuwac/uwac-window.c  | 276 ++++++++++++++++++++++++++++++++----
+ uwac/templates/config.h.in  |   1 +
+ 9 files changed, 364 insertions(+), 27 deletions(-)
+
