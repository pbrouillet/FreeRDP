new file mode 100644
index 000000000..f339f979c
--- /dev/null
+++ b/.github/workflows/build-clients.yml
@@ -0,0 +1,155 @@
+name: Build FreeRDP Clients
+
+on:
+  workflow_dispatch:
+    inputs:
+      targets:
+        description: 'Client targets to build'
+        required: true
+        type: choice
+        default: 'all'
+        options:
+          - all
+          - sdl
+          - x11
+          - wayland
+          - macos
+          - windows
+      build_type:
+        description: 'CMake build type'
+        required: true
+        type: choice
+        default: 'RelWithDebInfo'
+        options:
+          - Debug
+          - Release
+          - RelWithDebInfo
+
+permissions:
+  contents: read
+
+jobs:
+  prepare:
+    runs-on: ubuntu-latest
+    outputs:
+      matrix: ${{ steps.filter.outputs.matrix }}
+    steps:
+      - id: filter
+        run: |
+          ALL='[
+            {"target":"sdl","os":"ubuntu-latest","preset":"config-client-sdl.cmake"},
+            {"target":"x11","os":"ubuntu-latest","preset":"config-client-x11.cmake"},
+            {"target":"wayland","os":"ubuntu-latest","preset":"config-client-wayland.cmake"},
+            {"target":"macos","os":"macos-latest","preset":"config-client-mac.cmake"},
+            {"target":"windows","os":"ubuntu-latest","preset":"config-client-windows.cmake"}
+          ]'
+
+          TARGET="${{ inputs.targets }}"
+          if [ "$TARGET" = "all" ]; then
+            MATRIX="$ALL"
+          else
+            MATRIX=$(echo "$ALL" | jq -c "[.[] | select(.target == \"$TARGET\")]")
+          fi
+          echo "matrix={\"include\":$(echo "$MATRIX" | jq -c .)}" >> "$GITHUB_OUTPUT"
+
+  build:
+    needs: prepare
+    strategy:
+      fail-fast: false
+      matrix: ${{ fromJSON(needs.prepare.outputs.matrix) }}
+
+    name: "${{ matrix.target }} (${{ inputs.build_type }})"
+    runs-on: ${{ matrix.os }}
+    continue-on-error: false
+
+    steps:
+      - name: Checkout code
+        uses: actions/checkout@v4
+        continue-on-error: false
+
+      - name: Install dependencies (Linux)
+        if: runner.os == 'Linux' && matrix.target != 'windows'
+        continue-on-error: false
+        run: |
+          sudo apt-get update -q -y
+          sudo apt-get install -q -y \
+            ninja-build \
+            libssl-dev \
+            libx11-dev \
+            libxext-dev \
+            libxinerama-dev \
+            libxcursor-dev \
+            libxv-dev \
+            libxi-dev \
+            libxrandr-dev \
+            libxrender-dev \
+            libxfixes-dev \
+            libxkbfile-dev \
+            libwayland-dev \
+            libpulse-dev \
+            libasound2-dev \
+            libcups2-dev \
+            libsdl2-dev \
+            libusb-1.0-0-dev \
+            libudev-dev \
+            libfuse3-dev \
+            libcairo2-dev \
+            libavcodec-dev \
+            libavutil-dev \
+            libswscale-dev \
+            libswresample-dev \
+            libpkcs11-helper1-dev \
+            libkrb5-dev
+
+      - name: Install dependencies (Windows cross-compile)
+        if: matrix.target == 'windows'
+        continue-on-error: false
+        run: |
+          sudo apt-get update -q -y
+          sudo apt-get install -q -y \
+            ninja-build \
+            mingw-w64 \
+            mingw-w64-tools \
+            binutils-mingw-w64 \
+            nasm \
+            meson \
+            cmake
+
+      - name: Install dependencies (macOS)
+        if: runner.os == 'macOS'
+        continue-on-error: false
+        run: |
+          brew install ninja openssl cmake sdl2 pkg-config
+
+      - name: Configure (CMake)
+        if: matrix.target != 'windows'
+        continue-on-error: false
+        run: |
+          cmake -GNinja \
+            -DCMAKE_BUILD_TYPE=${{ inputs.build_type }} \
+            -C ci/cmake-preloads/${{ matrix.preset }} \
+            -B build \
+            -S .
+
+      - name: Configure & Build (Windows cross-compile)
+        if: matrix.target == 'windows'
+        continue-on-error: false
+        run: |
+          ./scripts/mingw.sh
+
+      - name: Build
+        if: matrix.target != 'windows'
+        continue-on-error: false
+        run: |
+          cmake --build build --parallel
+
+      - name: Upload build artifacts
+        uses: actions/upload-artifact@v4
+        continue-on-error: false
+        with:
+          name: freerdp-${{ matrix.target }}-${{ inputs.build_type }}
+          path: |
+            build/bin/
+            build/client/
+          if-no-files-found: warn
+          retention-days: 7
diff --git a/.github/workflows/upstream-sync.yml b/.github/workflows/upstream-sync.yml
new file mode 100644
index 000000000..2e58d17ec
--- /dev/null
+++ b/.github/workflows/upstream-sync.yml
@@ -0,0 +1,110 @@
+# Sync fork's master with upstream (FreeRDP/FreeRDP) and check the
+# working branch for merge conflicts.
+#
+# Runs weekly on Sunday at 06:00 UTC and on manual dispatch.
+
+name: Upstream Sync
+
+on:
+  schedule:
+    - cron: "0 6 * * 0" # Every Sunday at 06:00 UTC
+  workflow_dispatch:
+
+permissions:
+  contents: write
+  issues: write
+
+jobs:
+  sync-fork:
+    runs-on: ubuntu-latest
+
+    steps:
+      # ── 1. Checkout the fork with full history ─────────────────────
+      - name: Checkout fork
+        uses: actions/checkout@v4
+        with:
+          fetch-depth: 0
+          token: ${{ secrets.GITHUB_TOKEN }}
+
+      # ── 2. Configure git identity ─────────────────────────────────
+      - name: Configure git user
+        run: |
+          git config user.name  "github-actions[bot]"
+          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
+
+      # ── 3. Add upstream remote ─────────────────────────────────────
+      - name: Add upstream remote
+        run: |
+          git remote add upstream https://github.com/FreeRDP/FreeRDP.git
+
+      # ── 4. Fetch upstream master ───────────────────────────────────
+      - name: Fetch upstream master
+        run: |
+          git fetch upstream master
+
+      # ── 5. Fast-forward master to match upstream ───────────────────
+      - name: Update master (fast-forward only)
+        run: |
+          git checkout master
+          if ! git merge upstream/master --ff-only; then
+            echo "::error::Fast-forward merge failed — master has diverged from upstream."
+            echo "Manual intervention is required. Do NOT force-push."
+            exit 1
+          fi
+
+      # ── 6. Push updated master back to the fork ────────────────────
+      - name: Push master to origin
+        run: |
+          git push origin master
+
+      # ── 7. Check working branch for conflicts with updated master ──
+      - name: Check working branch for merge conflicts
+        env:
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+        run: |
+          BRANCH="feature/pbrouillet/copilot-agent"
+
+          # Make sure we have the working branch locally
+          git fetch origin "$BRANCH"
+          git checkout "$BRANCH"
+
+          # Attempt a trial merge (no commit, no fast-forward)
+          if git merge --no-commit --no-ff master 2>&1; then
+            echo "✅ No conflicts — $BRANCH merges cleanly with master."
+            git merge --abort 2>/dev/null || true
+          else
+            # Capture conflict details before aborting
+            CONFLICTS=$(git diff --name-only --diff-filter=U)
+            git merge --abort 2>/dev/null || true
+
+            echo "⚠️  Merge conflicts detected between master and $BRANCH"
+            echo "$CONFLICTS"
+
+            ISSUE_BODY=$(cat <<EOF
+          ## Upstream Sync — Merge Conflicts Detected
+
